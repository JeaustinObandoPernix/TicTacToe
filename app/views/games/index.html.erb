<div class="container mt-4">
  <div class="row">
    <div class="col-md-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Partidas de TicTacToe</h1>
        <%= link_to "Nueva Partida", new_game_path, class: "btn btn-primary" %>
      </div>

      <% if @games.any? %>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>Jugador 1</th>
                <th>Jugador 2</th>
                <th>Símbolos</th>
                <th>Estado</th>
                <th>Ganador</th>
                <th>Fecha</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% @games.each do |game| %>
                <tr>
                  <td>
                    <strong><%= game.player1 %></strong>
                    <span class="badge bg-primary ms-1">(<%= game.player1_symbol %>)</span>
                  </td>
                  <td>
                    <strong><%= game.player2 %></strong>
                    <span class="badge bg-success ms-1">(<%= game.player2_symbol %>)</span>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark">
                      <%= game.player1_symbol %> vs <%= game.player2_symbol %>
                    </span>
                  </td>
                  <td>
                    <span class="badge <%= game.status == 'active' ? 'bg-success' : 'bg-secondary' %>">
                      <%= game.status.humanize %>
                    </span>
                  </td>
                  <td>
                    <% if game.winner.present? %>
                      <span class="badge bg-warning text-dark">
                        <%= game.winner_name %> (<%= game.winner %>)
                      </span>
                    <% else %>
                      <span class="text-muted">-</span>
                    <% end %>
                  </td>
                  <td><%= game.created_at.strftime("%d/%m/%Y %H:%M") %></td>
                  <td>
                    <%= link_to "Ver", game_path(game), class: "btn btn-sm btn-info" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <h3 class="text-muted">No hay partidas aún</h3>
          <p class="text-muted">¡Crea tu primera partida de TicTacToe!</p>
          <%= link_to "Crear Partida", new_game_path, class: "btn btn-primary btn-lg" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
